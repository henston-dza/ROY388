---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';
import { getAllPublishers } from '../lib/publishers';

export const prerender = true;

const db = getDatabase();
const games = await getAllGames(db);
const publishers = await getAllPublishers(db);
const categories = [...new Map(
  games.flatMap((game) => game.category ? [[game.category.id, game.category]] : []),
).values()].sort((left, right) => left.name.localeCompare(right.name));
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div data-testid="catalog">
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <form
            class="mb-8 grid gap-6 rounded-xl border border-slate-700 bg-slate-800/60 p-6 shadow-lg md:grid-cols-[2fr_1fr_auto]"
            data-testid="game-filters"
            aria-label="Filter games"
          >
            <fieldset>
              <legend class="mb-3 text-sm font-semibold text-slate-200">Categories</legend>
              <div class="flex flex-wrap gap-3">
                {categories.map((category) => (
                  <label class="flex items-center gap-2 text-sm text-slate-300">
                    <input
                      type="checkbox"
                      value={category.id}
                      data-filter-category
                      data-testid={`category-filter-${category.id}`}
                      class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                    />
                    <span>{category.name}</span>
                  </label>
                ))}
              </div>
            </fieldset>

            <div>
              <label for="publisher-filter" class="mb-3 block text-sm font-semibold text-slate-200">
                Publisher
              </label>
              <select
                id="publisher-filter"
                data-filter-publisher
                data-testid="publisher-filter"
                class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              >
                <option value="">All publishers</option>
                {publishers.map((publisher) => (
                  <option value={publisher.id}>{publisher.name}</option>
                ))}
              </select>
            </div>

            <div class="flex items-end">
              <button
                type="reset"
                data-filter-reset
                data-testid="reset-game-filters"
                class="w-full rounded-lg border border-slate-600 px-4 py-2 text-sm font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              >
                Clear filters
              </button>
            </div>
          </form>

          <p
            class="mb-4 text-sm text-slate-400"
            data-filter-count
            data-testid="game-filter-count"
            role="status"
            aria-live="polite"
          >
            Showing {games.length} {games.length === 1 ? 'game' : 'games'}
          </p>

          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>

          <div class="mt-6 hidden" data-filter-empty data-testid="filter-empty-state">
            <EmptyState text="No games match the selected filters." />
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const categoryFilters = Array.from(
    document.querySelectorAll<HTMLInputElement>('[data-filter-category]'),
  );
  const publisherFilter = document.querySelector<HTMLSelectElement>('[data-filter-publisher]');
  const resetButton = document.querySelector<HTMLButtonElement>('[data-filter-reset]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
  const emptyState = document.querySelector<HTMLElement>('[data-filter-empty]');
  const resultCount = document.querySelector<HTMLElement>('[data-filter-count]');

  function applyFilters(): void {
    const selectedCategories = categoryFilters
      .filter((filter) => filter.checked)
      .map((filter) => filter.value);
    const selectedPublisher = publisherFilter?.value ?? '';
    let visibleCount = 0;

    cards.forEach((card) => {
      const categoryMatches =
        selectedCategories.length === 0 ||
        selectedCategories.includes(card.dataset.categoryId ?? '');
      const publisherMatches =
        selectedPublisher === '' || card.dataset.publisherId === selectedPublisher;
      const isVisible = categoryMatches && publisherMatches;

      card.hidden = !isVisible;
      if (isVisible) visibleCount += 1;
    });

    emptyState?.classList.toggle('hidden', visibleCount > 0);
    if (resultCount) {
      resultCount.textContent = `Showing ${visibleCount} ${visibleCount === 1 ? 'game' : 'games'}`;
    }
  }

  categoryFilters.forEach((filter) => filter.addEventListener('change', applyFilters));
  publisherFilter?.addEventListener('change', applyFilters);
  resetButton?.addEventListener('click', () => requestAnimationFrame(applyFilters));
</script>
